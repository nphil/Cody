{
  "name": "@nphil/cody",
  "version": "0.12.0",
  "description": "Cody — a local web workspace for the oh-my-pi (omp) coding agent",
  "homepage": "https://github.com/nphil/Cody#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nphil/Cody.git"
  },
  "bugs": {
    "url": "https://github.com/nphil/Cody/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "cody": "bin/cody.js"
  },
  "files": [
    "bin",
    "lib",
    "!bin/**/*.test.mjs",
    "!lib/**/*.test.mjs",
    ".next",
    "!.next/cache",
    "!.next/dev",
    "!.next/diagnostics",
    "!.next/types",
    "!.next/trace",
    "!.next/trace-build",
    "!.next/**/*.map",
    "public",
    "next.config.ts",
    "package.json"
  ],
  "scripts": {
    "dev": "node --experimental-strip-types bin/cody-server.js --dev -H 127.0.0.1 -p 30178",
    "dev:lan": "node --experimental-strip-types bin/cody-server.js --dev -H 0.0.0.0 -p 30178",
    "build": "next build --webpack",
    "start": "node --experimental-strip-types bin/cody-server.js -H 127.0.0.1 -p 30177",
    "start:lan": "node --experimental-strip-types bin/cody-server.js -H 0.0.0.0 -p 30177",
    "test": "node --experimental-strip-types --test lib/*.test.mjs lib/auth/*.test.mjs lib/harness/*.test.mjs lib/i18n/*.test.mjs lib/model-plan/*.test.mjs lib/omp/*.test.mjs lib/usage/*.test.mjs components/*.test.mjs components/ui/*.test.mjs hooks/*.test.mjs bin/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "release:check": "npm test && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cmdk": "^1.1.1",
    "http-proxy": "^1.18.1",
    "jiti": "^2.7.0",
    "lucide-react": "^1.27.0",
    "next": "16.3.0",
    "node-pty": "^1.1.0",
    "puppeteer-core": "^25.8.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-syntax-highlighter": "^16.1.1",
    "undici": "8.10.0",
    "ws": "^8.21.3",
    "yaml": "^2"
  },
  "devDependencies": {
    "@lobehub/icons": "^5.6.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "25.9.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.14.0",
    "postcss": "^8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
