<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon background: the same dressed tile as docker/icon.svg and
  public/icon-512.png (gradient ground + soft caret glow), so the Android app
  reads as the same product as the container and the PWA.

  Two deliberate differences from docker/icon.svg, both forced by the adaptive
  icon contract:

  1. Full bleed, no rounded-rect clip. The launcher owns the silhouette (circle,
     squircle, teardrop, ...) and masks this layer itself; clipping our own
     corners would show a rounded tile floating inside the launcher's shape.
     docker/icon.svg's hairline top highlight is dropped for the same reason —
     it traces a corner radius that does not exist here.
  2. The gradients are aligned to the inner 72dp the launcher actually shows
     (18..90 of the 108dp canvas), not to the whole canvas, so the visible tile
     shows the same full ramp and the same glow placement as the source art.
     Clamp extends the end colours across the 18dp effects margin the launcher
     reserves for parallax.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- ground: vertical ramp across the visible band -->
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="18"
                android:endX="0"
                android:endY="90"
                android:tileMode="clamp">
                <item android:offset="0" android:color="#FF2A2A40" />
                <item android:offset="0.55" android:color="#FF1E1E2E" />
                <item android:offset="1" android:color="#FF181825" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- glow: centred on the caret (0.72, 0.5) of the visible band, r = 0.55 -->
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="69.84"
                android:centerY="54"
                android:gradientRadius="39.6"
                android:tileMode="clamp">
                <item android:offset="0" android:color="#47CBA6F7" />
                <item android:offset="1" android:color="#00CBA6F7" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
