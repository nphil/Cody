<?xml version="1.0" encoding="utf-8"?>
<!--
  Cody ships en / ja / zh-CN UIs, so the Android client does too: values-ja and
  values-zh-rCN carry real translations of every string below, not placeholders.
  Adding a string here without adding it to both is a regression.
-->
<resources>
    <string name="app_name">Cody</string>

    <!-- Onboarding -->
    <string name="onboarding_title">Connect to Cody</string>
    <string name="onboarding_subtitle">Point this tablet at your Cody server. The address and credential are checked before anything is saved.</string>
    <string name="onboarding_address_label">Server address</string>
    <string name="onboarding_address_hint">cody.your-tailnet.ts.net:30177</string>
    <string name="onboarding_address_help">A bare host works; http:// is assumed unless you type https://.</string>
    <string name="onboarding_mode_sign_in">Sign in</string>
    <string name="onboarding_mode_paste_token">Paste a token</string>
    <string name="onboarding_username">Username</string>
    <string name="onboarding_password">Password</string>
    <string name="onboarding_sign_in_help">Your password is used once to create a token for this device, then discarded.</string>
    <string name="onboarding_token">Personal access token</string>
    <string name="onboarding_token_help">Create one in Cody\'s account settings, then paste it here.</string>
    <string name="onboarding_connect">Connect</string>
    <string name="onboarding_checking">Checking…</string>
    <string name="onboarding_show_password">Show password</string>
    <string name="onboarding_hide_password">Hide password</string>

    <!-- Failures -->
    <string name="error_address_unusable">That is not a server address. Try a host name, or host:port.</string>
    <string name="error_token_missing">Enter the token to continue.</string>
    <string name="error_credentials_missing">Enter your username and password.</string>
    <string name="error_token_rejected">The server rejected that token. Check that you pasted all of it, and that it has not been revoked.</string>
    <string name="error_sign_in_rejected">Wrong username or password.</string>
    <string name="error_bearer_forbidden">This device\'s token cannot create another token. Sign in with your password instead, or paste a token made in Cody\'s settings.</string>
    <string name="error_token_limit">This account already has the maximum number of tokens. Revoke one in Cody\'s account settings and try again.</string>
    <string name="error_forbidden">The server refused that request.</string>
    <string name="error_unreachable">Cannot reach that address. Check the host, the port, and that you are on the same network or tailnet.</string>
    <string name="error_not_found">Not found on that server. It may be a different Cody, or an older one.</string>
    <string name="error_rate_limited">Too many attempts. Wait a moment and try again.</string>
    <string name="error_server">The server returned an error.</string>
    <string name="error_malformed">The server\'s answer could not be read. It may be a newer or older Cody than this app expects.</string>
    <string name="error_signed_out">Your token is no longer valid. Connect again.</string>

