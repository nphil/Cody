<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-app language support: the three locales Cody ships. Declaring them makes
  the app appear in Android's per-app language picker, so the tablet can run Cody
  in Japanese while the system stays in English.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ja" />
    <locale android:name="zh-CN" />
</locale-config>
