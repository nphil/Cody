# Optional remote Cody origin for desktop development/builds.
# This file is documentation only and is never loaded by the build.
#
# Precedence (highest first): a non-empty CODY_DESKTOP_REMOTE_URL process
# environment variable, desktop/.env.local, then desktop/.env. A present but
# empty process variable disables the env-file values. Without a configured URL
# the shell builds with local-only capabilities and starts in Local WSL2 mode.
# The URL must be HTTPS, use the default HTTPS port, and contain no userinfo,
# query, or fragment. Use a private value only in ignored .env/.env.local.
CODY_DESKTOP_REMOTE_URL=https://remote.example.invalid
